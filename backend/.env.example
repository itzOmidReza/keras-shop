# Production Secret Key (Minimum 32 characters long)
SECRET_KEY=change_this_to_a_super_secret_32_char_long_string_for_production_security

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sage_user
POSTGRES_PASSWORD=sage_secure_password
POSTGRES_DB=sage_ecommerce_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379