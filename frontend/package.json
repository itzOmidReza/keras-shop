{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "keras",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:rtl": "grep -rnE \"\\b(ml|mr|pl|pr|text-left|text-right)-\" app --include=*.vue --exclude-dir=input-otp && exit 1 || exit 0",
    "lint:tokens": "grep -rnE \"#[0-9a-fA-F]{6}\\b\" app --include=*.vue --exclude-dir=ui && exit 1 || exit 0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "^5.3.16",
    "@pinia/nuxt": "^1.0.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "shadcn-nuxt": "2.8.2",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.11.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^2.2.0"
  }
}
