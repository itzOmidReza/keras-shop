{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "keras",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:rtl": "grep -rnE \"\\b(ml|mr|pl|pr|text-left|text-right)-\" app --include=*.vue --exclude-dir=input-otp && exit 1 || exit 0",
    "lint:tokens": "grep -rnE \"#[0-9a-fA-F]{6}\\b\" app --include=*.vue && exit 1 || exit 0",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.5",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "^3.7.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.0"
  }
}
