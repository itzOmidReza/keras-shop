# ==============================================================================
# Keras Atelier E-Commerce Environment Configuration
# ==============================================================================

# Application Environment ("development" | "production")
ENVIRONMENT=production

# Public Host / Frontend URL (used for redirects, canonical URLs, and payment callbacks)
FRONTEND_URL=http://localhost:3000

# Security Secret Key (Must be at least 32 characters long for HS256 JWT signature)
SECRET_KEY=change_this_to_a_super_secret_32_char_long_string_for_production_security

# Cross-Origin Resource Sharing (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kerass.ir,https://www.kerass.ir

# Exposed Host Ports for Docker Compose
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Configuration
POSTGRES_USER=sage_user
POSTGRES_PASSWORD=kerash#shop
POSTGRES_DB=keras_db

# Redis Cache & Broker
REDIS_HOST=redis
REDIS_PORT=6379

# Media Storage & CDN Configuration
# STORAGE_TYPE: "local" (uses disk volume) or "ftp" (uploads to remote storage)
STORAGE_ENABLED=false
STORAGE_TYPE=local
STORAGE_HOST=
STORAGE_PORT=21
STORAGE_USERNAME=
STORAGE_PASSWORD=
STORAGE_BASE_PATH=public_html/products
STORAGE_CDN_URL=https://dl.kerass.ir

# Payment Gateway - Saman Electronic Payment (SEP)
SEP_TERMINAL_ID=
SEP_REDIRECT_URL=
USE_MOCK_PAYMENT=true

# SMS Verification Provider (FarazSMS)
FARAZSMS_API_KEY=
FARAZSMS_ORIGINATOR=90008361
FARAZSMS_PATTERN_CODE=
FARAZSMS_CODE_VARIABLE=code

